# ─── SierraTrac Environment Variables ───
# Copy this file to .env and fill in your values

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-string

# PostgreSQL
DATABASE_URL=postgresql://sierratrac:password@localhost:5432/sierratrac

# Azure Blob Storage (not needed in development — uses local filesystem)
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
# AZURE_CONTAINER_NAME=instrument-photos
